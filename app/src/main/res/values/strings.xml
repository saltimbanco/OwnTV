<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="content_search_channels">Search channels\u2026</string>
    <string name="content_search_movies">Search movies…</string>
    <string name="content_search_series">Search series…</string>
    <!-- Cross-playlist failover popup: the interrupted channel is retried on another playlist.
         %1$s = channel name, %2$s = playlist switched to, %3$d = attempt, %4$d = matches total. -->
    <string name="failover_switching">Trying %1$s on %2$s (%3$d of %4$d)</string>
    <!-- Cross-playlist failover exhausted: nothing else plays the interrupted channel. %1$s = channel name. -->
    <string name="failover_exhausted">No working stream for %1$s</string>
    <!-- Bulk server-list import: a plain-text file with one Xtream/Stalker server per line. -->
    <string name="settings_sources_import_file">Import from file</string>
    <!-- Bulk import progress. %1$d = current server (1-based), %2$d = servers total. -->
    <string name="settings_bulk_import_title">Importing servers… %1$d/%2$d</string>
    <string name="settings_bulk_import_done">Servers imported</string>
    <plurals name="settings_bulk_import_added">
        <item quantity="one">%1$d added</item>
        <item quantity="other">%1$d added</item>
    </plurals>
    <plurals name="settings_bulk_import_failed">
        <item quantity="one">%1$d failed</item>
        <item quantity="other">%1$d failed</item>
    </plurals>
    <string name="settings_bulk_import_parse_error">Can’t read server list</string>
    <string name="settings_bulk_import_no_profile">No active profile</string>
    <string name="settings_bulk_import_empty">No usable servers in this file</string>
    <plurals name="settings_bulk_import_unreadable">
        <item quantity="one">%1$d unreadable line, no usable servers</item>
        <item quantity="other">%1$d unreadable lines, no usable servers</item>
    </plurals>
    <!-- %1$s = file name. -->
    <string name="settings_bulk_import_unreadable_file">Could not read %1$s</string>
    <!-- Default display names for servers/portals the file does not name. %1$d = running number. -->
    <string name="settings_bulk_import_default_server">Server %1$d</string>
    <string name="settings_bulk_import_default_portal">Portal %1$d</string>
    <!-- A failed server and why. %1$s = server name, %2$s = reason. -->
    <string name="settings_bulk_import_failure_line">%1$s — %2$s</string>
    <string name="settings_bulk_import_format_hint">Expected one server per line, e.g. “xtream;Name;http://host:port;user;pass”, “stalker;Name;http://portal;00:1A:79:AA:BB:CC”, or an Xtream URL like “http://host:port/get.php?username=user&amp;password=pass”. Importing replaces the existing playlists.</string>
</resources>
